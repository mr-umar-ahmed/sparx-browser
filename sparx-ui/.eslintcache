ction when external state changes.\n\nCalling setState synchronously within an effect body causes cascading renders that can hurt performance, and is not recommended. (https://react.dev/learn/you-might-not-need-an-effect).\n\n/app/sparx-ui/src/renderer/src/hooks/useAuth.ts:25:7\n  23 |     } catch (err) {\n  24 |       console.error(\"Firebase Auth Error\", err);\n> 25 |       setIsAuthLoading(false);\n     |       ^^^^^^^^^^^^^^^^ Avoid calling setState() directly within an effect\n  26 |       return () => {};\n  27 |     }\n  28 |   }, []);",{"range":"3786","text":"2657"},{"range":"3787","text":"2657"},{"range":"3788","text":"2657"},{"range":"3789","text":"2657"},{"range":"3790","text":"2657"},{"range":"3791","text":"2657"},{"range":"3792","text":"2657"},{"range":"3793","text":"2657"},{"range":"3794","text":"2657"},{"range":"3795","text":"2657"},{"range":"3796","text":"2660"},{"range":"3797","text":"2657"},"Replace `·id:·string;·title:·string;·url:·string;·favicon?:·string;·pinned?:·boolean;·isLoading?:·boolean;·` with `⏎··id:·string⏎··title:·string⏎··url:·string⏎··favicon?:·string⏎··pinned?:·boolean⏎··isLoading?:·boolean⏎`",{"range":"3798","text":"3799"},"Replace `·title:·string;·url:·string;·` with `⏎··title:·string⏎··url:·string⏎`",{"range":"3800","text":"3801"},"Replace `·id:·string;·title:·string;·content:·string;·timestamp:·number;·` with `⏎··id:·string⏎··title:·string⏎··content:·string⏎··timestamp:·number⏎`",{"range":"3802","text":"3803"},["3804","3805"],{"range":"3806","text":"2657"},{"range":"3807","text":"2657"},"'error' is defined but never used.",{"range":"3808","text":"2657"},{"range":"3809","text":"2657"},{"range":"3810","text":"2657"},{"range":"3811","text":"2657"},"Replace `·return·`https://www.google.com/s2/favicons?domain=${new·URL(url).hostname}&sz=32`;·}·catch·{·return·null;` with `⏎····return·`https://www.google.com/s2/favicons?domain=${new·URL(url).hostname}&sz=32`⏎··}·catch·{⏎····return·null⏎·`",{"range":"3812","text":"3813"},{"range":"3814","text":"2657"},"Replace `·safeParse('sparx_tabs',·[{·id:·'1',·title:·'New·Tab',·url:·'sparx://newtab',·isLoading:·false·}]));` with `⏎····safeParse('sparx_tabs',·[⏎······{·id:·'1',·title:·'New·Tab',·url:·'sparx://newtab',·isLoading:·false·}⏎····])⏎··)`",{"range":"3815","text":"3816"},"Replace `()·=>·localStorage.getItem('sparx_activeTab')·||·'1');` with `⏎····()·=>·localStorage.getItem('sparx_activeTab')·||·'1'⏎··)`",{"range":"3817","text":"3818"},{"range":"3819","text":"2657"},{"range":"3820","text":"2657"},{"range":"3821","text":"2657"},{"range":"3822","text":"2657"},{"range":"3823","text":"2657"},{"range":"3824","text":"2657"},{"range":"3825","text":"2657"},{"range":"3826","text":"2657"},{"range":"3827","text":"2657"},{"range":"3828","text":"2657"},"Replace `·localStorage.setItem('sparx_tabs',·JSON.stringify(tabs));·},·[tabs]);` with `⏎····localStorage.setItem('sparx_tabs',·JSON.stringify(tabs))⏎··},·[tabs])`",{"range":"3829","text":"3830"},"Replace `·localStorage.setItem('sparx_activeTab',·activeTabId);·},·[activeTabId]);` with `⏎····localStorage.setItem('sparx_activeTab',·activeTabId)⏎··},·[activeTabId])`",{"range":"3831","text":"3832"},"Replace `·localStorage.setItem('sparx_bookmarks',·JSON.stringify(bookmarks));·},·[bookmarks]);` with `⏎····localStorage.setItem('sparx_bookmarks',·JSON.stringify(bookmarks))⏎··},·[bookmarks])`",{"range":"3833","text":"3834"},"Replace `·localStorage.setItem('sparx_history',·JSON.stringify(history));·},·[history]);` with `⏎····localStorage.setItem('sparx_history',·JSON.stringify(history))⏎··},·[history])`",{"range":"3835","text":"3836"},"Replace `·localStorage.setItem('sparx_notes',·JSON.stringify(notes));·},·[notes]);` with `⏎····localStorage.setItem('sparx_notes',·JSON.stringify(notes))⏎··},·[notes])`",{"range":"3837","text":"3838"},"Replace `·localStorage.setItem('sparx_privacy',·JSON.stringify(isPrivacyMode));·},·[isPrivacyMode]);` with `⏎····localStorage.setItem('sparx_privacy',·JSON.stringify(isPrivacyMode))⏎··},·[isPriva