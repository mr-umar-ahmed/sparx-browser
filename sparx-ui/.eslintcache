h,·height:·containerRef.current.offsetHeight·});` with `⏎······width:·containerRef.current.offsetWidth,⏎······height:·containerRef.current.offsetHeight⏎····})`",{"range":"3618","text":"3619"},{"range":"3620","text":"2657"},{"range":"3621","text":"2657"},{"range":"3622","text":"2657"},{"range":"3623","text":"2657"},{"range":"3624","text":"2657"},{"range":"3625","text":"2657"},{"range":"3626","text":"2657"},{"range":"3627","text":"2657"},{"range":"3628","text":"2657"},"Replace `\"wheel\",·handleWheel,·{·passive:·false·});` with `'wheel',·handleWheel,·{·passive:·false·})`",{"range":"3629","text":"3630"},"Replace `\"wheel\",·handleWheel);` with `'wheel',·handleWheel)`",{"range":"3631","text":"3632"},{"range":"3633","text":"2657"},{"range":"3634","text":"2657"},{"range":"3635","text":"2657"},{"range":"3636","text":"2657"},{"range":"3637","text":"2657"},{"range":"3638","text":"2657"},{"range":"3639","text":"2657"},{"range":"3640","text":"2657"},{"range":"3641","text":"2657"},{"range":"3642","text":"2657"},{"range":"3643","text":"2657"},{"range":"3644","text":"2657"},{"range":"3645","text":"2657"},{"range":"3646","text":"2657"},"Replace `\"mousemove\",·handleMouseMove);` with `'mousemove',·handleMouseMove)`",{"range":"3647","text":"3648"},{"range":"3649","text":"3648"},{"range":"3650","text":"2657"},"Replace `\"line\"),·200);` with `'line'),·200)`",{"range":"3651","text":"3652"},"Replace `\"circle\"),·1200);` with `'circle'),·1200)`",{"range":"3653","text":"3654"},{"range":"3655","text":"2657"},{"range":"3656","text":"2657"},{"range":"3657","text":"2657"},{"range":"3658","text":"2657"},"Error: Cannot call impure function during render\n\n`Math.random` is an impure function. Calling an impure function can produce unstable results that update unpredictably when the component happens to re-render. (https://react.dev/reference/rules/components-and-hooks-must-be-pure#components-and-hooks-must-be-idempotent).\n\n/app/sparx-ui/src/renderer/src/components/ui/scroll-morph-hero.tsx:198:11\n  196 |   const scatterPositions = useMemo(() => {\n  197 |     return IMAGES.map(() => ({\n> 198 |       x: (Math.random() - 0.5) * 1500,\n      |           ^^^^^^^^^^^^^ Cannot call impure function\n  199 |       y: (Math.random() - 0.5) * 1000,\n  200 |       rotation: (Math.random() - 0.5) * 180,\n  201 |       scale: 0.6,","Error: Cannot call impure function during render\n\n`Math.random` is an impure function. Calling an impure function can produce unstable results that update unpredictably when the component happens to re-render. (https://react.dev/reference/rules/components-and-hooks-must-be-pure#components-and-hooks-must-be-idempotent).\n\n/app/sparx-ui/src/renderer/src/components/ui/scroll-morph-hero.tsx:199:11\n  197 |     return IMAGES.map(() => ({\n  198 |       x: (Math.random() - 0.5) * 1500,\n> 199 |       y: (Math.random() - 0.5) * 1000,\n      |           ^^^^^^^^^^^^^ Cannot call impure function\n  200 |       rotation: (Math.random() - 0.5) * 180,\n  201 |       scale: 0.6,\n  202 |       opacity: 0,","Error: Cannot call impure function during render\n\n`Math.random` is an impure function. Calling an impure function can produce unstable results that update unpredictably when the component happens to re-render. (https://react.dev/reference/rules/components-and-hooks-must-be-pure#components-and-hooks-must-be-idempotent).\n\n/app/sparx-ui/src/renderer/src/components/ui/scroll-morph-hero.tsx:200:18\n  198 |       x: (Math.random() - 0.5) * 1500,\n  199 |       y: (Math.random() - 0.5) * 1000,\n> 200 |       rotation: (Math.random() - 0.5) * 180,\n      |                  ^^^^^^^^^^^^^ Cannot call impure function\n  201 |       scale: 0.6,\n  202 |       opacity: 0,\n  203 |     }));",{"range":"3659","text":"2657"},{"range":"3660","text":"2657"},{"range":"3661","text":"2657"},{"range":"3662","text":"2657"},{"range":"3663","text":"2657"},{"range":"3664","text":"2657"},"Replace `\"change\",·setMorphValue);` with `'change',·setMorphValue)`",{"ran